{
  "name": "infotv-tizen",
  "version": "0.8.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "build": "node tools/build-standalone.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tools/smoke-browser.mjs",
    "package": "npm run build && python3 tools/package.py",
    "test:live": "node tools/live-playback-browser.mjs",
    "test:latency": "node tools/live-latency-browser.mjs",
    "test:navigation": "node tools/navigation-regression-browser.mjs",
    "test:vod": "node tools/vod-playback-browser.mjs",
    "test:startup": "node tools/startup-browser.mjs",
    "test:security": "node tools/security-qa-browser.mjs",
    "test:ux": "node tools/ux-usability-browser.mjs",
    "test:native-wasm": "node tools/native-wasm-integration.mjs",
    "test:timeline": "node tools/timeline-regression-browser.mjs"
  },
  "devDependencies": {
    "buffer": "6.0.3",
    "crypto-js": "4.2.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.0.0",
    "hls.js": "1.7.4",
    "mp4box": "0.5.4",
    "mpegts.js": "1.8.0"
  }
}
