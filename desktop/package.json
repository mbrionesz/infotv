{
  "name": "xuperwindows",
  "version": "0.1.5",
  "private": true,
  "description": "XuperWindows para Windows 10/11 \u2014 beta",
  "author": "MatiasB",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --ia32",
    "test": "node --test ../tests/desktop/*.test.mjs"
  },
  "devDependencies": {
    "electron": "43.8.10",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.matiasb.xuperwindows",
    "productName": "XuperWindows",
    "asar": true,
    "directories": {
      "output": "../dist/windows"
    },
    "files": [
      "*.cjs",
      "resolvers.json",
      "ui/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "XuperWindows-${version}-beta-${arch}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "buildUniversalInstaller": false,
      "guid": "1c34ecb8-f5b3-550a-82d4-579ad83249d6"
    },
    "compression": "normal",
    "extraResources": [
      {
        "from": "native/${arch}",
        "to": "decoder",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "productName": "XuperWindows"
}
